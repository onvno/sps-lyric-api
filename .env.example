# Docker Compose reads this file after copying it to .env.
BIND_HOST=127.0.0.1
PORT=8787
ADMIN_MODE=false
REVIEWER_TOKEN=
PUBLIC_BASE_URL=
GITHUB_ISSUES_URL=
JAMENDO_CLIENT_ID=
# Optional: absolute host directories (defaults: ./data and ./dist/releases).
# LYRICS_DATA_DIR=/absolute/path/data
# LYRICS_RELEASE_DIR=/absolute/path/releases
# On Linux/macOS, set these to the owner of the host data directory.
# LOCAL_UID=1000
# LOCAL_GID=1000
